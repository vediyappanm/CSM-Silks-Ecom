# Optional local overrides (copy to frontend/.env.local)
# Google Sign-In only works when the same client ID is set in backend .env
# AND the current site origin is listed in Google Cloud Console.
# VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# VITE_STORE_PHONE=919876543210
# VITE_STORE_PHONE_DISPLAY=+91 98765 43210
